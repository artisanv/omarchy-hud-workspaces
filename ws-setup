#!/usr/bin/env bash
# ws-setup — install, remove or check HUD Workspaces' Hyprland integration.
#
#   ws-setup install [--no-drop] [--auto-reapply] [--quiet]
#       number keys follow the bar, 3-finger swipe follows the bar, and
#       (unless --no-drop) window drop onto cards. --auto-reapply also adds
#       an Omarchy post-update hook that runs `reapply` after each update
#       (opt-in: it edits your Hyprland config without asking)
#   ws-setup remove     put stock Omarchy keys and swipe back
#   ws-setup status     one JSON line describing what's set up (the widget
#                       shows this in Settings → Integration)
#   ws-setup reapply    install again with the options last chosen, if it was
#                       installed and has been changed (e.g. by an update)
#
# Everything lives in one generated file, ~/.config/hypr/hud_workspaces.lua,
# loaded by a marked block at the end of hyprland.lua:
#
#   -- >>> HUD Workspaces (managed by ws-setup) >>>
#   pcall(require, "hypr.hud_workspaces")
#   -- <<< HUD Workspaces <<<
#
# The generated file checks that the plugin is still installed; if it isn't,
# it binds nothing and restores the stock swipe, so deleting the plugin
# without running `remove` can't leave dead keys. The stock workspace swipe
# line in input.lua is commented out inside the same kind of markers and
# uncommented again by `remove`. Hand-pasted snippets from the README of
# earlier versions are recognised and moved into the managed file.
#
# Every edited file is backed up first (to
# ~/.config/omarchy/hud-workspaces/backups, last 20 kept); if
# Hyprland reports config errors afterwards, the backups are restored.

set -u
mode=${1:-status}
shift || true

hypr=${XDG_CONFIG_HOME:-$HOME/.config}/hypr
main=$hypr/hyprland.lua
gen=$hypr/hud_workspaces.lua
input=$hypr/input.lua
bindings=$hypr/bindings.lua
state_dir=${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/hud-workspaces
state=$state_dir/setup.json
hook=${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/hooks/post-update.d/hud-workspaces.hook
here=$(dirname "$(readlink -f "$0")")

log_file=${XDG_STATE_HOME:-$HOME/.local/state}/hud-workspaces/log
log() {
  ( umask 077; mkdir -p -- "${log_file%/*}" && chmod 700 -- "${log_file%/*}"
    printf '%s ws-setup %s\n' "$(date '+%F %T')" "$*" >>"$log_file"; chmod 600 -- "$log_file" ) 2>/dev/null
}

quiet=0
drop=1
auto=0
for arg in "$@"; do
  case $arg in
    --no-drop) drop=0 ;;
    --drop) drop=1 ;;
    --quiet) quiet=1 ;;
    --auto-reapply) auto=1 ;;
  esac
done
say() { (( quiet )) || echo "$@"; }

begin_mark='-- >>> HUD Workspaces (managed by ws-setup) >>>'
end_mark='-- <<< HUD Workspaces <<<'
gesture_begin='-- >>> HUD Workspaces: stock workspace swipe off (ws-setup remove turns it back on) >>>'
stock_gesture='hl.gesture({ fingers = 3, direction = "horizontal", action = "workspace" })'

generated() {
  cat <<'LUA'
-- HUD Workspaces — generated by ws-setup; edits here are overwritten.
-- Change options with: ws-setup install [--no-drop]; undo with: ws-setup remove
local plugin = os.getenv("HOME") .. "/.config/omarchy/plugins/swordfish.workspaces"
local ws_step = plugin .. "/ws-step"
local present = io.open(ws_step, "r")
if not present then
  -- Plugin removed without `ws-setup remove`: keep stock behaviour.
  hl.gesture({ fingers = 3, direction = "horizontal", action = "workspace" })
  return
end
present:close()

-- Super+<number> goes to the n-th card on the bar (past the last card, to
-- workspace <number>); Shift moves the active window, Shift+Alt moves it
-- without following. "Keys follow the bar" in the widget turns this off.
for n = 1, 10 do
  local key = "code:" .. tostring(n + 9)
  hl.unbind("SUPER + " .. key)
  hl.unbind("SUPER + SHIFT + " .. key)
  hl.unbind("SUPER + SHIFT + ALT + " .. key)
  o.bind("SUPER + " .. key, "Switch to card " .. n, ws_step .. " slot " .. n)
  o.bind("SUPER + SHIFT + " .. key, "Move window to card " .. n, ws_step .. " move " .. n)
  o.bind("SUPER + SHIFT + ALT + " .. key, "Move window silently to card " .. n, ws_step .. " move-silent " .. n)
end

-- 3-finger swipe follows the bar order; direction and wrap-around are set
-- in the widget (right-click + → Settings).
hl.gesture({ fingers = 3, direction = "left", action = function() hl.exec_cmd(ws_step .. " swipe left") end })
hl.gesture({ fingers = 3, direction = "right", action = function() hl.exec_cmd(ws_step .. " swipe right") end })
LUA
  (( drop )) || return 0
  cat <<'LUA'

-- Window drop: Super+drag a window onto a card on the bar to move it there.
-- Hyprland gives bars no drag events, so the compositor side reports the
-- drop and the widget hit-tests the cards. Only real window drags count
-- (Super held, or the window itself moved): dragging a tab, text or a file
-- inside a window up to the bar does nothing.
local dropWindow, dropAt, dropSuper

hl.bind("SUPER + mouse:272", function()
  local w = hl.get_active_window()
  dropSuper = w and w.address or nil
end, { non_consuming = true, description = "HUD Workspaces: note a window drag" })

hl.bind("mouse:272", function()
  dropWindow = hl.get_active_window()
  dropAt = dropWindow and { x = dropWindow.at.x, y = dropWindow.at.y } or nil
end, { non_consuming = true, description = "HUD Workspaces: track drag origin" })

hl.bind("mouse:272", function()
  local origin, startAt, super = dropWindow, dropAt, dropSuper
  dropWindow, dropAt, dropSuper = nil, nil, nil
  if not origin then return end
  local cursor = hl.get_cursor_pos()
  if cursor.y > 40 then return end   -- the bar strip (raise for a taller bar)
  local window = hl.get_active_window()
  if not window or window.address ~= origin.address then return end
  local moved = startAt and (window.at.x ~= startAt.x or window.at.y ~= startAt.y)
  if super ~= window.address and not moved then return end
  hl.dispatch(hl.dsp.event("wsdrag," .. window.address .. "," .. cursor.x .. "," .. cursor.y))
end, { drag = true, ignore_mods = true, non_consuming = true, description = "HUD Workspaces: drop window on a card" })
LUA
}

# Copies go to $state_dir/backups (the last 20 are kept); prints
# "<original>|<copy>".
backup() {
  local f=$1 dir=$state_dir/backups
  [[ -f $f ]] || return 0
  mkdir -p -- "$dir"
  local b="$dir/${f##*/}.$(date +%Y%m%d-%H%M%S).$$"
  cp -p -- "$f" "$b" && echo "$f|$b"
  ls -1t -- "$dir" | tail -n +21 | while read -r old; do rm -f -- "$dir/$old"; done
}

# Remove the README snippets earlier versions asked people to paste.
strip_legacy() {
  local tmp
  if [[ -f $bindings ]] && grep -q 'swordfish.workspaces/ws-step' "$bindings"; then
    tmp=$(mktemp)
    awk '
      /^-- HUD Workspaces: Super\+<number>/ { skip = 1 }
      skip && /^local hud_ws_step/ { inblock = 1 }
      skip && inblock && /^end$/ { skip = 0; inblock = 0; next }
      !skip
    ' "$bindings" >"$tmp" && ! grep -q 'swordfish.workspaces/ws-step' "$tmp" && cat "$tmp" >"$bindings"
    rm -f "$tmp"
  fi
  if [[ -f $input ]] && grep -qE 'swordfish.workspaces/ws-step|Drop dragged window on bar workspace' "$input"; then
    tmp=$(mktemp)
    awk '
      /^-- 3-finger swipe follows HUD Workspaces/ { skip = 1 }
      skip == 1 && /ws_step \.\. " swipe right"/ { skip = 0; next }
      /^-- Drag a window and drop it on a workspace number in the bar/ { skip = 2 }
      skip == 2 && /Drop dragged window on bar workspace/ { skip = 0; next }
      !skip
    ' "$input" >"$tmp" &&
      ! grep -qE 'swordfish.workspaces/ws-step|Drop dragged window on bar workspace' "$tmp" && cat "$tmp" >"$input"
    rm -f "$tmp"
  fi
}

legacy_present() {
  grep -qs 'swordfish.workspaces/ws-step' "$bindings" ||
    grep -qsE 'swordfish.workspaces/ws-step|Drop dragged window on bar workspace' "$input"
}

# Comment the stock swipe out inside markers (also adopts the bare
# "-- hl.gesture(...)" left by the old README instructions).
stock_gesture_off() {
  [[ -f $input ]] || return 0
  grep -qF -- "$gesture_begin" "$input" && return 0
  local tmp
  tmp=$(mktemp)
  awk -v g="$stock_gesture" -v b="$gesture_begin" -v e="$end_mark" '
    !done && ($0 == g || $0 == "-- " g) {
      print b; print "-- " g; print e; done = 1; next
    }
    /^-- Disabled: steps by workspace number, not by the bar/ { next }
    { print }
  ' "$input" >"$tmp" && cat "$tmp" >"$input"
  rm -f "$tmp"
}

stock_gesture_on() {
  [[ -f $input ]] || return 0
  grep -qF -- "$gesture_begin" "$input" || return 0
  local tmp
  tmp=$(mktemp)
  awk -v g="$stock_gesture" -v b="$gesture_begin" -v e="$end_mark" '
    $0 == b { inside = 1; next }
    inside && $0 == e { inside = 0; next }
    inside && $0 == "-- " g { print g; next }
    inside { next }
    { print }
  ' "$input" >"$tmp" && cat "$tmp" >"$input"
  rm -f "$tmp"
}

stock_gesture_active() {
  grep -qxF -- "$stock_gesture" "$input" 2>/dev/null
}

loader_present() {
  grep -qF -- "$begin_mark" "$main" 2>/dev/null
}

add_loader() {
  loader_present && return 0
  printf '\n%s\npcall(require, "hypr.hud_workspaces")\n%s\n' "$begin_mark" "$end_mark" >>"$main"
}

remove_loader() {
  loader_present || return 0
  local tmp
  tmp=$(mktemp)
  awk -v b="$begin_mark" -v e="$end_mark" '
    $0 == b { inside = 1; next }
    inside && $0 == e { inside = 0; next }
    !inside
  ' "$main" >"$tmp" && cat "$tmp" >"$main"
  rm -f "$tmp"
  # Drop the blank line add_loader put before the block.
  sed -i -e :a -e '/^\n*$/{$d;N;ba' -e '}' "$main"
}

install_hook() {
  mkdir -p -- "${hook%/*}"
  cat >"$hook" <<EOF
#!/usr/bin/env bash
# HUD Workspaces: put the Hyprland integration back if an update reverted it.
script=\$HOME/.config/omarchy/plugins/swordfish.workspaces/ws-setup
[[ -x \$script ]] && "\$script" reapply --quiet
exit 0
EOF
  chmod +x "$hook"
}

reload_or_rollback() {
  local backups=("$@") errors
  # For tests against a copy of the config.
  [[ ${HUD_SETUP_NO_RELOAD:-} == 1 ]] && return 0
  hyprctl reload >/dev/null 2>&1
  sleep 0.5
  errors=$(hyprctl configerrors 2>/dev/null | grep -v '^\s*$' | grep -vi 'no errors')
  if [[ -n $errors ]]; then
    local pair
    for pair in "${backups[@]}"; do
      [[ -n $pair ]] || continue
      cp -p -- "${pair#*|}" "${pair%%|*}"
    done
    hyprctl reload >/dev/null 2>&1
    log "$mode: Hyprland reported errors, restored backups: $errors"
    echo "Hyprland reported config errors; your previous config was restored:" >&2
    echo "$errors" >&2
    return 1
  fi
  return 0
}

status_json() {
  local installed=false current=false legacy=false stock=false hookp=false drop_on=false
  loader_present && [[ -f $gen ]] && installed=true
  if [[ -f $gen ]]; then
    grep -q 'drop window on a card' "$gen" && drop_on=true
    local d=0
    [[ $drop_on == true ]] && d=1
    [[ $(drop=$d generated) == "$(cat "$gen")" ]] && current=true
  fi
  legacy_present && legacy=true
  stock_gesture_active && stock=true
  [[ -x $hook ]] && hookp=true
  local ever=false
  [[ -f $state ]] && ever=true
  jq -cn --argjson everInstalled $ever --argjson installed $installed --argjson current $current --argjson legacy $legacy \
    --argjson stockSwipe $stock --argjson hook $hookp --argjson drop $drop_on \
    '{everInstalled: $everInstalled, installed: $installed, current: $current, legacy: $legacy, stockSwipe: $stockSwipe,
      hook: $hook, drop: $drop,
      ok: ($installed and $current and ($legacy | not) and ($stockSwipe | not))}'
}

do_install() {
  [[ -f $main ]] || { echo "No $main — is this Omarchy 4?" >&2; exit 1; }
  local backups=()
  local f b
  for f in "$main" "$input" "$bindings" "$gen"; do
    b=$(backup "$f") && [[ -n $b ]] && backups+=("$b")
  done
  strip_legacy
  stock_gesture_off
  generated >"$gen"
  add_loader
  if ! reload_or_rollback "${backups[@]}"; then exit 1; fi
  mkdir -p -- "$state_dir"
  [[ $mode == reapply && -x $hook ]] && auto=1
  jq -cn --argjson drop $([[ $drop == 1 ]] && echo true || echo false) \
    --argjson auto $([[ $auto == 1 ]] && echo true || echo false) '{drop: $drop, autoReapply: $auto}' >"$state"
  if (( auto )); then install_hook; else rm -f -- "$hook"; fi
  log "installed (drop=$drop)"
  say "HUD Workspaces Hyprland integration installed (window drop: $([[ $drop == 1 ]] && echo on || echo off))."
  say "Backups of the edited files: $state_dir/backups"
}

do_remove() {
  local backups=() f b
  for f in "$main" "$input" "$bindings" "$gen"; do
    b=$(backup "$f") && [[ -n $b ]] && backups+=("$b")
  done
  strip_legacy
  remove_loader
  stock_gesture_on
  # A plain stock line if the old README had it commented without markers.
  if ! stock_gesture_active && grep -qxF -- "-- $stock_gesture" "$input" 2>/dev/null; then
    sed -i "s|^-- $(printf '%s' "$stock_gesture" | sed 's/[][\.*^$|]/\\&/g')\$|$stock_gesture|" "$input"
  fi
  rm -f -- "$gen" "$hook" "$state"
  reload_or_rollback "${backups[@]}" || exit 1
  log "removed"
  say "HUD Workspaces Hyprland integration removed; stock keys and swipe are back."
}

case $mode in
  install) do_install ;;
  remove|uninstall) do_remove ;;
  status) status_json ;;
  reapply)
    [[ -f $state ]] || exit 0
    [[ $(jq -r '.drop' "$state" 2>/dev/null) == false ]] && drop=0 || drop=1
    st=$(status_json)
    if [[ $(jq -r '.ok' <<<"$st") != true ]]; then
      log "reapply: integration was changed ($st), installing again"
      do_install
    fi
    ;;
  generate) generated ;;
  *) echo "usage: ws-setup install [--no-drop] | remove | status | reapply" >&2; exit 2 ;;
esac
